kvader -7.0 -0.6 -2.5   0.15 5.4 0.15   0.0 0.0 0.0
farba 250 205 60
toroid -7.0 -3.45 -2.5   0.18 0.0   10 10   1.5708 0.0 0.0

farba 40 170 175
meshbe -7.0 -1.2 -2.5   0.0 0.0 0.0
 0.075  0.00 0.0   0.575  0.04 0.25   1.075  0.08 0.35   1.575  0.12 0.1   2.075  0.16 -0.15   2.575  0.20 -0.1   3.075  0.24 0.3
