# ==================================================================
#  Celestial Garden - a showcase of every Graph3D object type
# ==================================================================
#  A ringed planet floats above a stone pedestal in a hilly garden,
#  guarded by a vermilion gate with hanging lanterns, a waving flag,
#  two giant flowers, stepping stones and a belt of tumbling asteroids.
#
#  Conventions (inherited from the original program):
#    * +Y points DOWN on screen, so "up" in this scene is negative Y.
#    * Angles are in radians, applied around Z, then Y, then X.
#    * "farba r g b" sets the colour (0-255) of all following objects.
#    * Trick: a toroid with outer radius 0 is a sphere.
# ==================================================================

kamera 0.0 0.0 7.0 0.8

# ------------------------------------------------------------------
#  Ground - rolling hills: one 7x7 Bezier surface, 18 x 18 units
#  (rows run front to back, columns left to right; y = height, + is down)
# ------------------------------------------------------------------
farba 96 150 72
meshbe 0.0 2.2 0.0   0.0 0.0 0.0
 -9.0 0.70 -9.0   -6.0 0.30 -9.0   -3.0 0.00 -9.0   0.0 0.15 -9.0   3.0 0.30 -9.0   6.0 0.00 -9.0   9.0 0.60 -9.0
 -9.0 0.30 -6.0   -6.0 -0.10 -6.0  -3.0 -0.40 -6.0  0.0 -0.25 -6.0  3.0 -0.10 -6.0  6.0 -0.40 -6.0  9.0 0.20 -6.0
 -9.0 0.20 -3.0   -6.0 -0.20 -3.0  -3.0 -0.50 -3.0  0.0 -0.35 -3.0  3.0 -0.20 -3.0  6.0 -0.50 -3.0  9.0 0.10 -3.0
 -9.0 0.30  0.0   -6.0 -0.10  0.0  -3.0 -0.40  0.0  0.0 -0.25  0.0  3.0 -0.10  0.0  6.0 -0.40  0.0  9.0 0.20  0.0
 -9.0 0.40  3.0   -6.0 0.00  3.0   -3.0 -0.30  3.0  0.0 -0.15  3.0  3.0 0.00  3.0   6.0 -0.30  3.0  9.0 0.30  3.0
 -9.0 0.60  6.0   -6.0 0.20  6.0   -3.0 -0.10  6.0  0.0 0.05  6.0   3.0 0.20  6.0   6.0 -0.10  6.0  9.0 0.50  6.0
 -9.0 0.80  9.0   -6.0 0.40  9.0   -3.0 0.10  9.0   0.0 0.25  9.0   3.0 0.40  9.0   6.0 0.10  9.0   9.0 0.70  9.0

# ------------------------------------------------------------------
#  Pedestal - plinth, a step turned 45 degrees, golden column, capital
# ------------------------------------------------------------------
farba 205 198 185
kvader 0.0 1.8 0.0    5.0 0.6 5.0    0.0 0.0 0.0
kvader 0.0 1.25 0.0   3.6 0.5 3.6    0.0 0.785 0.0
farba 220 175 70
kvader 0.0 -0.25 0.0  0.6 2.5 0.6    0.0 0.785 0.0
kvader 0.0 -1.6 0.0   1.1 0.2 1.1    0.0 0.785 0.0

# Corner ornaments on the plinth: a teal ring with a pearl on top
farba 60 180 170
toroid  2.1 1.38  2.1   0.12 0.32  10 20   1.5708 0.0 0.0
toroid -2.1 1.38  2.1   0.12 0.32  10 20   1.5708 0.0 0.0
toroid  2.1 1.38 -2.1   0.12 0.32  10 20   1.5708 0.0 0.0
toroid -2.1 1.38 -2.1   0.12 0.32  10 20   1.5708 0.0 0.0
farba 245 245 250
toroid  2.1 1.08  2.1   0.22 0.0  12 12   1.5708 0.0 0.0
toroid -2.1 1.08  2.1   0.22 0.0  12 12   1.5708 0.0 0.0
toroid  2.1 1.08 -2.1   0.22 0.0  12 12   1.5708 0.0 0.0
toroid -2.1 1.08 -2.1   0.22 0.0  12 12   1.5708 0.0 0.0

# ------------------------------------------------------------------
#  The planet (a sphere) and its three tilted rings
# ------------------------------------------------------------------
farba 235 135 55
toroid 0.0 -3.4 0.0   1.4 0.0   28 28   1.5708 0.0 0.0
farba 245 215 160
toroid 0.0 -3.4 0.0   0.10 2.15   8 56   -1.2 0.3 0.0
farba 205 160 110
toroid 0.0 -3.4 0.0   0.07 2.55   8 64   -1.2 0.3 0.0
farba 150 195 235
toroid 0.0 -3.4 0.0   0.05 2.90   6 72   -1.2 0.3 0.0

# Moons
farba 190 200 220
toroid  2.9 -5.6 -2.2   0.42 0.0   16 16   1.5708 0.0 0.0
farba 225 95 85
toroid -3.1 -5.0  1.2   0.28 0.0   14 14   1.5708 0.0 0.0

# Asteroid belt - six tumbling rocks
farba 140 130 165
kvader  3.64 -2.9  2.1   0.80 0.65 0.70   0.6 0.3 1.1
kvader  0.00 -2.5  4.2   0.55 0.70 0.50   1.2 0.4 0.2
farba 115 120 140
kvader -3.64 -2.9  2.1   0.85 0.55 0.65   0.3 1.0 0.7
kvader -3.64 -3.9 -2.1   0.65 0.65 0.65   0.9 0.2 0.5
farba 160 150 175
kvader  0.00 -4.3 -4.2   0.70 0.50 0.80   0.2 0.7 1.3
kvader  3.64 -3.9 -2.1   0.50 0.80 0.55   1.1 0.5 0.1

# ------------------------------------------------------------------
#  Gate at the back of the garden
# ------------------------------------------------------------------
farba 210 55 40
kvader -2.2  0.1  -7.0   0.35 4.2 0.35   0.0 0.0 0.0
kvader  2.2  0.1  -7.0   0.35 4.2 0.35   0.0 0.0 0.0
kvader  0.0 -2.15 -7.0   6.0 0.35 0.55   0.0 0.0 0.0
kvader  0.0 -1.4  -7.0   4.9 0.25 0.30   0.0 0.0 0.0
farba 40 40 45
kvader  0.0 -2.42 -7.0   6.4 0.18 0.65   0.0 0.0 0.0

# Two chains of interlocking links (alternating planes) ...
farba 170 175 185
toroid -1.1 -0.95 -7.0   0.06 0.35   8 18   0.0 0.0 0.0
toroid -1.1 -0.40 -7.0   0.06 0.35   8 18   0.0 1.5708 0.0
toroid -1.1  0.15 -7.0   0.06 0.35   8 18   0.0 0.0 0.0
toroid  1.1 -0.95 -7.0   0.06 0.35   8 18   0.0 0.0 0.0
toroid  1.1 -0.40 -7.0   0.06 0.35   8 18   0.0 1.5708 0.0
toroid  1.1  0.15 -7.0   0.06 0.35   8 18   0.0 0.0 0.0

# ... each holding a lantern
farba 255 200 80
kvader -1.1 0.75 -7.0   0.45 0.55 0.45   0.0 0.785 0.0
kvader  1.1 0.75 -7.0   0.45 0.55 0.45   0.0 0.785 0.0
farba 40 40 45
kvader -1.1 0.44 -7.0   0.55 0.08 0.55   0.0 0.785 0.0
kvader  1.1 0.44 -7.0   0.55 0.08 0.55   0.0 0.785 0.0

# ------------------------------------------------------------------
#  Flag pole with a waving flag (Bezier surface)
# ------------------------------------------------------------------
