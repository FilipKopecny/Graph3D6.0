<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Graph3D</RootNamespace>
    <AssemblyName>Graph3D</AssemblyName>
    <Version>7.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- WFO5001: Application.SetColorMode (dark mode) is still flagged as experimental. -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
    <!-- The previous implementation is kept for reference only. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);_legacy/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Update="TOR.DAT" CopyToOutputDirectory="PreserveNewest" />
    <None Update="samples\*.dat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.Graphics" Version="4.9.4" />
    <PackageReference Include="OpenTK.Windowing.Desktop" Version="4.9.4" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
