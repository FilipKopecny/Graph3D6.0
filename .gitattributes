# Normalise line endings of text files.
* text=auto

*.cs      text diff=csharp
*.md      text
*.sln     text eol=crlf
*.csproj  text eol=crlf
*.resx    text eol=crlf

# Scene files are kept byte for byte (the originals use CRLF).
*.dat     -text
*.DAT     -text

# The original DOS source is kept byte for byte as well.
_legacy/original/*.cpp  -text
_legacy/original/*.h    -text

*.png     binary
*.exe     binary
*.prj     binary
